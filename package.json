		"eslint-plugin-svelte": "^3.23.1",
		"mdsvex": "^0.12.6",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.61.0",
		"@noahbaumgartner/svelte-ui": "^0.0.8",
		"@sveltejs/adapter-vercel": "^6.2.0",
		"@vercel/analytics": "^1.6.1",
